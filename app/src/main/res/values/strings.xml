<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Screen Dimmer</string>
    <string name="app_description">Verdunkle deinen Bildschirm unter die minimale Helligkeit des Systems</string>

    <!-- Permissions -->
    <string name="permission_required">Berechtigung erforderlich</string>
    <string name="permission_description">Screen Dimmer benötigt die Berechtigung \"Über anderen Apps anzeigen\", um den Bildschirm zu verdunkeln.</string>
    <string name="grant_permission">Berechtigung erteilen</string>
    <string name="permission_granted">Berechtigung erteilt!</string>
    <string name="permission_denied">Berechtigung verweigert</string>

    <!-- Permission Dialog -->
    <string name="permission_dialog_title">Overlay-Berechtigung</string>
    <string name="permission_dialog_message">Um den Bildschirm zu verdunkeln, muss \"Screen Dimmer\" über anderen Apps angezeigt werden dürfen.\n\nAuf der nächsten Seite:\n1. Finde \"Screen Dimmer\" in der Liste\n2. Aktiviere den Schalter</string>
    <string name="permission_dialog_button">Zu Einstellungen</string>

    <!-- Battery Optimization -->
    <string name="battery_optimization_title">Akku-Optimierung aktiv</string>
    <string name="battery_optimization_description">Die Akku-Optimierung kann den Dimmer im Hintergrund beenden und Zeitpläne verhindern. Deaktiviere sie für zuverlässigen Betrieb.</string>
    <string name="disable_battery_optimization">Deaktivieren</string>
    <string name="battery_optimization_disabled">Akku-Optimierung deaktiviert</string>
    <string name="battery_settings_not_found">Akku-Einstellungen nicht gefunden</string>

    <!-- Alarm Permission -->
    <string name="alarm_permission_title">Alarm-Berechtigung</string>
    <string name="alarm_permission_message">Um Zeitpläne zu verwenden, benötigt Screen Dimmer die Berechtigung für exakte Alarme.\n\nAuf der nächsten Seite:\n1. Finde \"Screen Dimmer\"\n2. Erlaube exakte Alarme</string>
    <string name="alarm_permission_granted">Alarm-Berechtigung erteilt!</string>
    <string name="alarm_settings_not_found">Alarm-Einstellungen nicht gefunden</string>

    <!-- Settings -->
    <string name="enable_dimmer">Dimmer aktivieren</string>
    <string name="enable_dimmer_description">Verdunkelungs-Overlay ein-/ausschalten</string>
    <string name="dim_level">Verdunkelungsstufe</string>
    <string name="dim_level_value">%d%%</string>
    <string name="start_on_boot">Bei Neustart starten</string>
    <string name="start_on_boot_description">Dimmer automatisch nach dem Hochfahren aktivieren</string>

    <!-- Schedule -->
    <string name="schedule_title">Zeitplan</string>
    <string name="auto_off_title">Automatisch ausschalten</string>
    <string name="auto_off_description">Dimmer zu einer bestimmten Uhrzeit ausschalten</string>
    <string name="auto_off_time">Ausschaltzeit</string>
    <string name="auto_on_title">Automatisch einschalten</string>
    <string name="auto_on_description">Dimmer zu einer bestimmten Uhrzeit einschalten</string>
    <string name="auto_on_time">Einschaltzeit</string>

    <!-- Quick Settings -->
    <string name="tile_label">Dimmer</string>
    <string name="tile_on">An (%d%%)</string>
    <string name="tile_off">Aus</string>
    <string name="tile_no_permission">Berechtigung fehlt</string>
    <string name="quick_settings_title">Schnelleinstellungen</string>
    <string name="quick_settings_instructions">Wische vom oberen Bildschirmrand nach unten und tippe auf das Stift-Symbol, um die Schnelleinstellungen zu bearbeiten. Ziehe die \"Dimmer\"-Kachel in deine Schnelleinstellungen.</string>

    <!-- Notification -->
    <string name="notification_channel_name">Dimmer Service</string>
    <string name="notification_channel_description">Zeigt an, wenn der Bildschirm-Dimmer aktiv ist</string>
    <string name="notification_title">Screen Dimmer aktiv</string>
    <string name="notification_text">Verdunkelung: %d%%</string>
    <string name="notification_action_stop">Ausschalten</string>
